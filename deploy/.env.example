# Copy to deploy/.env before running compose.
HARNESS_OIDC_ISSUER=https://login.example.internal/realms/engineering
HARNESS_OIDC_JWKS_URL=https://login.example.internal/realms/engineering/protocol/openid-connect/certs
# The console's public client. Register redirect URI https://<console origin>/auth/callback.
HARNESS_OIDC_CLIENT_ID=oracledbharness-console
# Add your API's scope here if the provider needs one to issue an access token for it.
HARNESS_OIDC_SCOPES=openid profile email
# true if the provider only issues a JWT for the API when the request names its audience.
HARNESS_OIDC_REQUEST_AUDIENCE=false
# Leave both empty to read them from the issuer's discovery document.
HARNESS_OIDC_AUTHORIZATION_ENDPOINT=
HARNESS_OIDC_TOKEN_ENDPOINT=
HARNESS_ALLOWED_ENDPOINTS=oracle-dev.internal:1521,oracle-test.internal:1521
HARNESS_COPILOT_ENABLED=false
# local: a model on this host, over loopback only. anthropic is refused while
# HARNESS_COPILOT_LOCAL_ONLY is true; setting it false lets prompts leave the host.
HARNESS_COPILOT_PROVIDER=local
HARNESS_COPILOT_LOCAL_ONLY=true
HARNESS_COPILOT_BASE_URL=http://127.0.0.1:8080/v1
# The id the local server lists under /v1/models.
HARNESS_COPILOT_MODEL=
HARNESS_COPILOT_API_KEY_REF=provider-api-key
