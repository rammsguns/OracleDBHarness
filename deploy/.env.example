# Copy to deploy/.env before running compose.
HARNESS_OIDC_ISSUER=https://login.example.internal/realms/engineering
HARNESS_OIDC_JWKS_URL=https://login.example.internal/realms/engineering/protocol/openid-connect/certs
HARNESS_ALLOWED_ENDPOINTS=oracle-dev.internal:1521,oracle-test.internal:1521
HARNESS_COPILOT_ENABLED=false
HARNESS_COPILOT_PROVIDER=anthropic
HARNESS_COPILOT_MODEL=claude-opus-5
HARNESS_COPILOT_API_KEY_REF=provider-api-key
