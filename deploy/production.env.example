# --- OracleDBHarness production configuration (placeholders only) -------------
# Copy to deploy/.env and fill in real values. Never commit real secrets, hosts,
# wallets or usernames. Every HARNESS_* key here is a real setting in
# services/api/harness_api/config.py; unknown keys are ignored, so do not invent
# new ones. TLS is terminated at the reverse proxy in front of the API (the app
# has no TLS settings of its own); the OIDC issuer and CORS origins below must
# therefore be https:// URLs.

# Stage 1 production is observation-only. This value drives the production
# refusals (worksheets, compile, session writes, mutating runbooks) and the
# Oracle 19c identity check.
HARNESS_ENV=production
HARNESS_LOG_LEVEL=INFO

# Metadata store. PostgreSQL in production; the password is a mounted file, not
# a literal in the URL.
HARNESS_METADATA_URL=postgresql+psycopg://harness@metadata:5432/harness
HARNESS_METADATA_PASSWORD_FILE=/run/secrets/postgres_password

# Identity. Production authenticates through OIDC; "dev" is refused outside
# development. The issuer and client are placeholders.
HARNESS_AUTH_MODE=oidc
HARNESS_OIDC_ISSUER=https://login.example.internal/realms/engineering
HARNESS_OIDC_AUDIENCE=oracledbharness
HARNESS_OIDC_JWKS_URL=https://login.example.internal/realms/engineering/protocol/openid-connect/certs
# The console's public client (authorization code with PKCE); its redirect URI is
# <console origin>/auth/callback.
HARNESS_OIDC_CLIENT_ID=oracledbharness-console
HARNESS_OIDC_SCOPES=openid profile email
# Leave both empty to read them from the issuer's discovery document.
HARNESS_OIDC_AUTHORIZATION_ENDPOINT=
HARNESS_OIDC_TOKEN_ENDPOINT=
HARNESS_OIDC_REQUEST_AUDIENCE=false

# Oracle driver. python-oracledb, thin mode (no Oracle Client libraries). The
# driver is pinned to 4.0.2 in services/worker/pyproject.toml; changing it is a
# PLAN.md G5 requalification.
HARNESS_ORACLE_BACKEND=oracledb
HARNESS_ORACLE_DRIVER_MODE=thin
HARNESS_ORACLE_CLIENT_LIB_DIR=

# Secret references. Values are read from this directory, never from the store.
HARNESS_SECRET_DIR=/run/secrets

# Execution limits (see docs/architecture.md "Execution and transactions").
HARNESS_MAX_ROWS=1000
HARNESS_MAX_RESPONSE_BYTES=10485760
HARNESS_STATEMENT_TIMEOUT_SECONDS=30
HARNESS_WORKSHEET_IDLE_SECONDS=300
HARNESS_MAX_DBMS_OUTPUT_BYTES=65536
HARNESS_LOB_PREVIEW_BYTES=8192
HARNESS_WORKER_PROCESSES=4

# Allowed database endpoints operators may register (host:port, comma separated).
# Documentation addresses only (203.0.113.0/24 and example hostnames); replace
# with the real production Oracle 19c listener. Never leave this empty.
HARNESS_ALLOWED_ENDPOINTS=203.0.113.10:1521,oracle-prod.example.internal:1521

# Copilot and Kiwi are disabled in production (PLAN.md fixed constraints). Leave
# both off; the values below are the safe defaults and are not used while off.
HARNESS_COPILOT_ENABLED=false
HARNESS_COPILOT_PROVIDER=local
HARNESS_COPILOT_LOCAL_ONLY=true
HARNESS_COPILOT_BASE_URL=http://127.0.0.1:8080/v1
HARNESS_COPILOT_MODEL=
HARNESS_COPILOT_API_KEY_REF=
HARNESS_KIWI_ENABLED=false

# Exact origin allowlist, no wildcards. The console and API share an origin
# through the reverse proxy, so this is the single deployed console origin.
HARNESS_CORS_ORIGINS=https://console.example.internal
