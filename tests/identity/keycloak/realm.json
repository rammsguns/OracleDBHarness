{
  "realm": "engineering",
  "displayName": "OracleDBHarness sign-in qualification",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 300,
  "clients": [
    {
      "clientId": "oracledbharness-console",
      "name": "OracleDBHarness console",
      "description": "Registered as docs/setup.md tells an operator to: public client, authorization code with PKCE S256, audience mapper for the API.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:8080/auth/callback",
        "http://127.0.0.1:5173/auth/callback",
        "http://localhost:5173/auth/callback"
      ],
      "webOrigins": [
        "http://127.0.0.1:8080",
        "http://127.0.0.1:5173",
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "access.token.lifespan": "60"
      },
      "protocolMappers": [
        {
          "name": "oracledbharness audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "oracledbharness",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "another-application",
      "name": "Some other application in the same realm",
      "description": "Configured like the console but with no audience mapper. Its tokens are genuine and must still be refused by the harness API.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://127.0.0.1:5173/auth/callback"],
      "webOrigins": ["http://127.0.0.1:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    }
  ],
  "users": [
    {
      "id": "e7c65d62-1b14-41d3-8255-70e28d4d8ef8",
      "username": "alice",
      "email": "alice@example.internal",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Example",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "qualification-only",
          "temporary": false
        }
      ]
    },
    {
      "id": "f81d4fae-7dec-11d0-a765-00a0c91e6bf6",
      "username": "bob",
      "email": "bob@example.internal",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Example",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "qualification-only",
          "temporary": false
        }
      ]
    }
  ]
}
