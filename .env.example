# --- OracleDBHarness pilot configuration -------------------------------------
# Copy to .env and adjust. Never commit real secrets.

HARNESS_ENV=development
HARNESS_LOG_LEVEL=INFO

# Metadata store. PostgreSQL in the pilot; SQLite is supported for local dev only.
HARNESS_METADATA_URL=sqlite+pysqlite:///./harness-metadata.sqlite3
# HARNESS_METADATA_URL=postgresql+psycopg://harness@localhost:5432/harness
# Where to read the store's password from, if it is delivered as a mounted file. Set
# this instead of putting the password in the URL; the file is the same one the store
# itself reads, so there is only one password to keep in step.
# HARNESS_METADATA_PASSWORD_FILE=/run/secrets/postgres_password

# Identity. "dev" issues local tokens for development only; "oidc" is the pilot mode.
HARNESS_AUTH_MODE=dev
HARNESS_OIDC_ISSUER=
HARNESS_OIDC_AUDIENCE=oracledbharness
HARNESS_OIDC_JWKS_URL=
# The console signs in as a public client (authorization code with PKCE); its
# redirect URI is <console origin>/auth/callback. Endpoints come from the issuer's
# discovery document unless both are set here.
HARNESS_OIDC_CLIENT_ID=
HARNESS_OIDC_SCOPES=openid profile email
HARNESS_OIDC_AUTHORIZATION_ENDPOINT=
HARNESS_OIDC_TOKEN_ENDPOINT=
HARNESS_OIDC_REQUEST_AUDIENCE=false
HARNESS_DEV_TOKEN_SECRET=change-me-in-any-shared-environment

# Oracle driver. "thin" is preferred; "thick" needs Oracle Client libraries and a
# separately deployed worker because driver mode is process-wide.
HARNESS_ORACLE_DRIVER_MODE=thin
HARNESS_ORACLE_CLIENT_LIB_DIR=
# "fake" runs the deterministic in-memory Oracle stand-in used by tests and demos.
HARNESS_ORACLE_BACKEND=fake

# Secret references. Values are read from this directory, never from the database.
HARNESS_SECRET_DIR=./deploy/secrets

# Execution limits (see MVP_PLAN.md "Execution design").
HARNESS_MAX_ROWS=1000
HARNESS_MAX_RESPONSE_BYTES=10485760
HARNESS_STATEMENT_TIMEOUT_SECONDS=30
HARNESS_WORKSHEET_IDLE_SECONDS=300
HARNESS_MAX_DBMS_OUTPUT_BYTES=65536
HARNESS_LOB_PREVIEW_BYTES=8192
HARNESS_WORKER_PROCESSES=4

# Allowed database endpoints operators may register (host:port, comma separated).
# Empty means "no restriction"; set this in any shared environment.
HARNESS_ALLOWED_ENDPOINTS=

# Copilot / AI provider. Disabled until an administrator enables it explicitly.
HARNESS_COPILOT_ENABLED=false
HARNESS_COPILOT_PROVIDER=fake
HARNESS_COPILOT_MODEL=claude-opus-5
HARNESS_COPILOT_API_KEY_REF=
HARNESS_COPILOT_MAX_CONTEXT_BYTES=131072
# Bounds each provider call. Thinking counts against the output token limit.
HARNESS_COPILOT_MAX_OUTPUT_TOKENS=8000
HARNESS_COPILOT_REQUEST_TIMEOUT_SECONDS=600
HARNESS_COPILOT_PROVIDER_MAX_RETRIES=2
HARNESS_COPILOT_USER_DAILY_REQUESTS=100
HARNESS_COPILOT_LOG_PROMPTS=false
