# A qualification profile for scripts/qual_run.sh. Copy to databases/qual/<name>.env
# (git-ignored) and run `scripts/qual_run.sh <name>`.
#
# Only HARNESS_QUAL_* variables belong here. Passwords are read from the files the
# *_PASSWORD_FILE variables name, never from this file. $REPO is the repository root.
# See tests/oracle_config.py and oracle/qualification/README.md for every variable.

# Primary target: a NON-PRODUCTION database. Fixtures run in HARNESS_APP.
HARNESS_QUAL_ORACLE_DSN=dbhost:1521/ORCLPDB1
HARNESS_QUAL_ORACLE_USER=harness_app
HARNESS_QUAL_ORACLE_PASSWORD_FILE=$REPO/databases/secrets/primary_harness_app.pw
HARNESS_QUAL_DRIVER_MODE=thin
# HARNESS_QUAL_ORACLE_CLIENT_LIB_DIR=/opt/oracle/instantclient   # thick mode only
# Transport for the primary database and the accounts on it. TCP without a wallet if unset.
# HARNESS_QUAL_PROTOCOL=tcps
# HARNESS_QUAL_WALLET_DIR=/path/to/wallet
# HARNESS_QUAL_WALLET_PASSWORD_FILE=$REPO/databases/secrets/primary_wallet.pw   # encrypted ewallet.pem

# Privileged account for the connection-loss checks (ALTER SYSTEM KILL SESSION).
HARNESS_QUAL_ADMIN_DSN=dbhost:1521/ORCLPDB1
HARNESS_QUAL_ADMIN_USER=system
HARNESS_QUAL_ADMIN_PASSWORD_FILE=$REPO/databases/secrets/primary_system.pw

# A genuinely separate database for the two-target isolation check.
HARNESS_QUAL_SECOND_DSN=otherhost:1521/ORCLPDB2
HARNESS_QUAL_SECOND_USER=harness_app
HARNESS_QUAL_SECOND_PASSWORD_FILE=$REPO/databases/secrets/second_harness_app.pw
# Its own transport; TCP without a wallet if unset.
# HARNESS_QUAL_SECOND_PROTOCOL=tcps
# HARNESS_QUAL_SECOND_WALLET_DIR=/path/to/other/wallet
# HARNESS_QUAL_SECOND_WALLET_PASSWORD_FILE=$REPO/databases/secrets/second_wallet.pw

# An account missing the panel grants (README "A restricted account" shape).
HARNESS_QUAL_RESTRICTED_USER=harness_restricted
HARNESS_QUAL_RESTRICTED_PASSWORD_FILE=$REPO/databases/secrets/primary_restricted.pw

# A read-only account on a lab schema with realistic data (T-5). Never the fixture schema.
HARNESS_QUAL_LAB_USER=harness_lab
HARNESS_QUAL_LAB_PASSWORD_FILE=$REPO/databases/secrets/primary_lab.pw
HARNESS_QUAL_LAB_SCHEMA=SH

# Environments this run claims to cover; a missing one fails instead of skipping.
HARNESS_QUAL_REQUIRE=admin,second_target,restricted_account,pdb,lab_schema
