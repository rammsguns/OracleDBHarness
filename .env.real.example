# Copy to .env for a local real Oracle run. Keep credentials in mode-600 files.
HARNESS_ENV=development
HARNESS_METADATA_URL=sqlite+pysqlite:///./databases/metadata-bootstrap.sqlite3
HARNESS_AUTH_MODE=dev
HARNESS_ORACLE_BACKEND=oracledb
HARNESS_ORACLE_DRIVER_MODE=thin
HARNESS_SECRET_DIR=./databases/secrets
HARNESS_ALLOWED_ENDPOINTS=localhost:1522,localhost:1521,203.0.113.10:3603,adb.<region>.oraclecloud.com:1522
HARNESS_COPILOT_ENABLED=false
HARNESS_COPILOT_PROVIDER=local
HARNESS_COPILOT_LOCAL_ONLY=true
HARNESS_COPILOT_BASE_URL=http://127.0.0.1:8080/v1
HARNESS_COPILOT_MODEL=qwen3.8-flash-next-iq3_s
HARNESS_KIWI_ENABLED=false
